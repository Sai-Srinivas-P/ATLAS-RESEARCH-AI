# LM Studio local server
LM_STUDIO_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen/qwen3-4b
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MAX_TOKENS=500

# Keep the workflow lightweight for a laptop.
LOCAL_FAST_MODE=true
MAX_RESEARCH_SOURCES=6
MAX_RESEARCH_ROUNDS=1
REQUEST_TIMEOUT_SECONDS=60

# Local Qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=atlas_documents_lmstudio

# FastEmbed runs locally and does not require Ollama.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
RAG_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ATLAS_HOST=0.0.0.0
ATLAS_PORT=8000
